
# .gitignore - Arquivos que NÃO devem ir para o GitHub
 
# Banco de dados — contém dados pessoais
eve.db
 
# Arquivo de configurações sensíveis — contém chaves secretas
.env
 
# Cache do Python — arquivos gerados automaticamente
__pycache__/
*.pyc
*.pyo
*.pyd
 
# Dados JSON locais da CLI
bancos_dados/json/*.json
 
# Ambiente virtual Python
venv/
env/
.venv/
